# This package will host the C++ runfiles library when it's finally released.

filegroup(
    name = "srcs",
    srcs = glob(
        ["**/*"],
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "runfiles",
    srcs = ["runfiles.cc"],
    hdrs = ["runfiles.h"],
    visibility = ["//visibility:public"],
)
